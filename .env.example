# URL canonique du site (sans slash final). Utilisée pour sitemap, robots, Open Graph, JSON-LD.
# Exemple : https://rgfightclub.fr
NEXT_PUBLIC_SITE_URL=

# Payload CMS — secret aléatoire (32+ caractères). Générer avec : openssl rand -base64 32
PAYLOAD_SECRET=

# MongoDB Atlas — URI de connexion (mongodb+srv://...)
DATABASE_URI=

# Vercel Blob — token lecture/écriture (ajouté automatiquement si Blob est lié au projet Vercel)
BLOB_READ_WRITE_TOKEN=

# Formulaire de contact — provider d’envoi : web3forms (défaut) | resend
CONTACT_EMAIL_PROVIDER=web3forms

# Destinataire de test (optionnel, Resend uniquement). Si défini, remplace l’e-mail CMS.
# Laisser vide en production pour utiliser Paramètres globaux → Contact.
CONTACT_TO_EMAIL=

# Web3Forms — https://web3forms.com
# Free plan : envoi depuis le navigateur. L’e-mail lié à la access key = destinataire.
WEB3FORMS_ACCESS_KEY=

# Resend — utilisé seulement si CONTACT_EMAIL_PROVIDER=resend
# Clé API : https://resend.com/api-keys (format re_...)
RESEND_API_KEY=
# Adresse d’expéditeur sur un domaine vérifié chez Resend (ex. contact@rg-fight-club.fr)
RESEND_FROM_EMAIL=
